# Leave unset to run the offline repair engine (recommended for demos).
# Set it to your deployed Supabase Edge Function to use the live model.
# VITE_REPAIR_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/repair

# The Anthropic key is NEVER set here. It belongs to the edge function only:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
