# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With none of it set, the app runs in local
# mode: real trips, saved in the browser, no account. That is the safest
# configuration for a demo and it cannot be broken by the venue wifi.
# ---------------------------------------------------------------------------

# Supabase — real accounts and shared trips.
# Both must be set, or the app stays in local mode.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Live repair strategies from Claude, via the edge function in
# ../supabase/functions/repair. Unset = the offline engine, which produces the
# same three options.
# VITE_REPAIR_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/repair

# The Anthropic API key is NEVER set here — it would end up in the browser
# bundle. It belongs only to the edge function's secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
